<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ themed splash: the app icon on the app's dark background.
         Configuration-specific styles replace the base one, so every item is
         repeated here. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:colorBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowSplashScreenBackground">@color/brand_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
